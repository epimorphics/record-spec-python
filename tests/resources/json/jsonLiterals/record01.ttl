@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
<http://example.org/id/foo> a <http://example.org/def/Foo> ;
    <http://example.org/def/stringProp> "stringValue" ;
    <http://example.org/def/intProp> "42"^^xsd:int ;
    <http://example.org/def/integerProp> 21 ;
    <http://example.org/def/floatProp> "3.141E0"^^xsd:float ;
    <http://example.org/def/doubleProp> "1.23E-1"^^xsd:double ;
    <http://example.org/def/decimalProp> "9.99"^^xsd:decimal ;
    <http://example.org/def/booleanProp> true ;
    <http://example.org/def/dateProp> "2000-01-01"^^xsd:date ;
    <http://example.org/def/dateTimeProp> "2000-01-01T01:01:01.01Z"^^xsd:dateTime ;
.
