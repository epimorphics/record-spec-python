{
  "$id": "http://example.org/spec/Foo",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/spec:Foo",
  "definitions": {
    "spec:Foo": {
      "type": "object",
      "properties": {
        "@id": {
          "type": "string"
        },
        "@type": {
          "type": "string",
          "enum": ["http://example.org/def/Foo"]
        },
        "minMaxInt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "minMaxDouble": {
          "type": "number",
          "exclusiveMinimum": 0.0,
          "exclusiveMaximum": 100.0
        }
      },
      "required": ["@type"]
    },
    "_ref": {
      "type": "object",
      "properties": {
        "@id": {
          "type": "string"
        }
      },
      "required": [
        "@id"
      ]
    }
  }
}
