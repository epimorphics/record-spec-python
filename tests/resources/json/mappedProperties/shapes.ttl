@prefix def: <http://example.org/def/> .
@prefix rec: <http://vocab.epimorphics.com/record-spec/def/> .
@prefix spec: <http://example.org/spec/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix foo: <http://example.org/spec/Foo#> .
@prefix bar: <http://example.org/spec/Bar#> .

spec:Foo a sh:NodeShape ;
    sh:targetClass def:Foo ;
    sh:property foo:barNotationMap-kind, foo:barNotationMap-value, foo:barIdMap-kind, foo:barIdMap-value ;
.
foo:barNotationMap-kind
    sh:path def:barNotationMap ;
    sh:nodeKind sh:BlankNodeOrIRI ;
.
foo:barNotationMap-value
    sh:path def:barNotationMap ;
    sh:shape spec:Bar ;
.
foo:barIdMap-kind
    sh:path def:barIdMap ;
    sh:nodeKind sh:BlankNodeOrIRI ;
.
foo:barIdMap-value
    sh:path def:barIdMap ;
    sh:shape spec:Bar ;
.

spec:Bar a sh:NodeShape ;
    sh:targetClass def:Bar ;
    sh:property bar:notation-kind, bar:notation-count, bar:notation-value, bar:label-kind, bar:label-value ;
.

bar:notation-kind
    sh:path def:notation ;
    sh:nodeKind sh:Literal ;
.
bar:notation-count
    sh:path def:notation ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "Invalid count of http://example.org/def/notation on target shape. Expected exactly 1."@en ;
.
bar:notation-value
    sh:path def:notation ;
    sh:datatype xsd:string ;
.
bar:label-kind
    sh:path def:label ;
    sh:nodeKind sh:Literal ;
.
bar:label-value
    sh:path def:label ;
    sh:datatype xsd:string ;
.
