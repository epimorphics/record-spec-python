@prefix ex: <http://example.org/def/> .
@prefix rec: <http://vocab.epimorphics.com/record-spec/def/> .
@prefix spec: <http://example.org/spec/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

spec:schema a rec:Schema ;
    rec:record spec:Bar ;
.


spec:Bar a rec:Record ;
    rec:uri ex:Bar ;
    rec:shortCode "Bar" ;
    rec:property [
        a rec:LiteralProperty ;
        rec:shortCode "label" ;
        rec:uri ex:label ;
        rec:constraint [
            a rec:LiteralConstraint ;
            rec:datatype xsd:string ;
        ] ;
        rec:extension [
            a <http://epimorphics.com/record-spec/extension/simple> ;
                <http://epimorphics.com/record-spec/extension/value> "Property Annotation" ;
        ] ;
    ];
.
