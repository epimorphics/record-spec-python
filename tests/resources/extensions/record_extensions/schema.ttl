@prefix ex: <http://example.org/def/> .
@prefix rec: <http://vocab.epimorphics.com/record-spec/def/> .
@prefix spec: <http://example.org/spec/> .

spec:schema a rec:Schema ;
    rec:mixin spec:Foo ;
    rec:record spec:Bar ;
.

spec:Foo a rec:Mixin ;
    rec:extension [
        a <http://epimorphics.com/record-spec/extension/simple> ;
            <http://epimorphics.com/record-spec/extension/value> "Mixin Annotation" ;
    ] ;
.

spec:Bar a rec:Record ;
    rec:implements spec:Foo ;
    rec:uri ex:Bar ;
    rec:shortCode "Bar" ;
    rec:extension [
        a <http://epimorphics.com/record-spec/extension/simple> ;
            <http://epimorphics.com/record-spec/extension/value> "Record Annotation" ;
    ] ;
.
