@prefix ex: <http://example.org/def/> .
@prefix rec: <http://vocab.epimorphics.com/record-spec/def/> .
@prefix spec: <http://example.org/spec/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dct: <http://purl.org/dc/terms/> .


spec:schema a rec:Schema ;
    rec:record spec:Foo ;
    rec:prefixMapping
        [ rec:prefix "ex"; rec:uri "http://example.org/def/"],
        [ rec:prefix "spec"; rec:uri "http://example.org/spec/" ],
        [ rec:prefix "xsd"; rec:uri "http://www.w3.org/2001/XMLSchema#"]
    ;
.

spec:Foo a rec:Record ;
  rdfs:label "Foo Record"@en ;
  rdfs:comment "A record with various literal properties for testing purposes."@en ;
  dct:description "A record with various literal properties for testing purposes."@en ;
  rec:uri ex:Foo ;
  rec:shortCode "Foo" ;
  rec:property [
      a rec:LiteralProperty ;
      rdfs:label "String Property"@en ;
      rdfs:comment "A string property with a pattern constraint."@en ;
      dct:description "A string property with a pattern constraint that allows only strings starting with 'f' followed by zero or more 'o' characters."@en ;
      rec:uri ex:string ;
      rec:shortCode "string" ;
      rec:required true ;
      rec:repeatable true ;
      rec:constraint [
        a rec:LiteralConstraint ;
        rec:datatype xsd:string ;
        rec:pattern "f(o)*" ;
      ] ;
  ] ;
  rec:property [
    a rec:LiteralProperty ;
    rec:uri ex:integer ;
    rec:shortCode "integer" ;
    rec:repeatable true ;
    rec:constraint [
      a rec:LiteralConstraint ;
      rec:datatype xsd:integer ;
      rec:minInclusive 0;
      rec:maxInclusive 10;
    ] ;
  ] ;
  rec:property [
    a rec:LiteralProperty;
    rec:uri ex:decimal ;
    rec:shortCode "decimal";
    rec:required true ;
    rec:constraint [
      a rec:LiteralConstraint ;
      rec:datatype xsd:decimal ;
      rec:minExclusive 1.0 ;
      rec:maxExclusive 100.0 ;
    ] ;
  ] ;
  rec:property [
    a rec:LiteralProperty ;
    rec:uri ex:union ;
    rec:shortCode "union" ;
    rec:constraint [
      a rec:LiteralConstraint ;
      rec:datatype xsd:date ;
    ] ;
    rec:constraint [
      a rec:LiteralConstraint ;
      rec:datatype xsd:dateTime ;
    ] ;
  ] ;
  rec:property [
    a rec:LiteralProperty ;
    rec:uri ex:enum ;
    rec:shortCode "enum" ;
    rec:constraint [
      a rec:LiteralConstraint ;
      rec:datatype xsd:string ;
      rec:in "RED", "GREEN", "BLUE"
    ] ;
  ] ;
  rec:property [
    a rec:LiteralProperty ;
    rec:uri ex:open ;
    rec:shortCode "open" ;
  ] ;
.
